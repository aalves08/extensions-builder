lished.", "noStorageClass":"This cluster has more than one StorageClass and none of them is the default, so the build pod would stay Pending forever waiting for its volume. Pick one and mark it as the default.", "storageClassNotDefault":"This cluster has no default StorageClass, so the build pod would stay Pending forever waiting for its volume. The StorageClass {name} can be made the default.", "storageClassCreatable":"This cluster has no StorageClass at all, so the build pod would stay Pending forever waiting for its volume. The local-path provisioner is already running, so a default StorageClass can be created for it.", "storageClassInstallable":"This cluster has no StorageClass and no storage provisioner, so the build pod would stay Pending forever waiting for its volume. The local-path provisioner can be installed for you, into the local-path-storage namespace, and its StorageClass made the default. It keeps volumes on local node disk, which suits throwaway builds.", "multipleStorageClasses":"This cluster has more than one default StorageClass. Kubernetes will pick one, which may not be the one you expect.", "fix":({"namespace":"Create namespace", "nginxConfig":"Create config", "storageClass":"Fix storage", "storageProvisioner":"Install provisioner", "targetCluster":"Cluster to apply this to", "otherCluster":"Storage was set up in the {cluster} cluster. Builds run in the local cluster, so this check still has to pass there before you can start one.", "failed":"Could not fix this: {error}"})})})})];
