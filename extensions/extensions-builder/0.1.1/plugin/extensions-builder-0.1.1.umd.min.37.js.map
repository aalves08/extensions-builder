:({"title":"Host UI", "description":"Point the UI of this Rancher install at the dashboard built from the same source, so extensions are tested against the shell they were compiled against.", "warning":"This changes global settings and affects every user of this Rancher install on their next page load. Revert when you are done.", "noIndex":"This build did not produce a dashboard bundle, or has not reported one yet.", "buildIndex":"This build", "currentIndex":"ui-dashboard-index", "offlinePreferred":"ui-offline-preferred", "unset":"not set", "active":"Rancher is currently serving the dashboard from this build.", "apply":"Use the UI from this build", "revert":"Revert", "reloadHint":"Hard-refresh the browser after applying or reverting."}), "new":({"title":"New build", "intro":"A build clones the shell source, publishes it to a throwaway npm registry, builds each extension against it, and packages the results as a Helm repository. Expect 20 to 40 minutes.", "submit":"Start build", "shell":({"title":"Shell source", "description":"The rancher/dashboard code the shell packages are built from. This is the change under test.", "mode":"Source", "modePr":"Pull request", "modeRef":"Branch or tag", "repo":"Repository", "repoTooltip":"Normally rancher/dashboard. Point at a fork if the change lives there.", "pr":"Pull request", "prTooltip":"The PR number, or paste the full pull request URL. Fetched as refs/pull/<n>/head, so pull requests from forks work too.", "ref":"Branch or tag", "refTooltip":"Any branch or tag that exists on the repository above.", "refPlaceholder":"master", "checking":"Checking with GitHub...", "badRepo":"That does not look like a GitHub repository.", "badPr":"Enter a pull request number or URL.", "noSuchPr":"No such pull request on that repository.", "noSuchRef":"No such branch or tag on that repository.", "rateLimited":"GitHub rate-limited this browser. Wait a few minutes, or carry on - the build itself does not use the API.", "prMeta":"by {author} · {branch} · {sha}", "draft":"draft", "refOk":"{ref} resolved."}), "extensions":({"title":"Extensions", "description":"The official list comes from rancher/ui-plugin-charts, and each of those rows can be built from any branch or tag. To build anything else, add a git repository of your own.", "manifestFailed":"Could not load the official extension list: {error}. You can still add repositories by hand.", "selectAtLeastOne":"Select at least one extension to build.", "unnamed":"Unnamed extension", "latest":"latest published: {version}", "edit":"Edit", "hide":"Hide", "addCustom":"Add a repository", "officialHint":"From the official extension list. Its name, package and repository are what make it this extension, so only the branch or tag can be changed.", "name":"Name", "nameTooltip":"Used for the clone directory and to identify the row. Must be unique within a build.", "nameLockedTooltip":"Comes from the official extension list, and is what the chart and the installed extension are called. To build under a different name, add a repository instead.", "pkg":"Package", "pkgTooltip":"The folder under pkg/ in that repository. Usually the same as the name.", "pkgLockedTooltip":"Comes from the official extension list. It is the folder under pkg/ that actually gets built, so pointing it elsewhere would build a different extension, or fail because there is nothing there.", "ref":"Branch or tag", "refTooltip":"Leave empty to build the default branch of the repository. The gh-pages branch listed in the manifest holds published charts, not source, so it is never used here.", "refPlaceholder":"Default branch", "repo":"Repository", "repoLockedTooltip":"Comes from the official extension list and identifies this extension. To build from somewhere else, add a repository instead.", "errors":({"noRepo":"A repository URL is required.", "badRepo":"Must be an http(s) or git@ URL.", "noPkg":"A package name is required.", "noName":"A name is required.", "duplicateName":"Another selected extension already uses this name."})}), "external":({"title":"External access", "description":"By default a build is only reachable from inside this cluster, which is enough to install it here. Expose it as well and any other Rancher can add it as a repository, which is how the same build gets tested against an older Rancher.", "enable":"Make this build installable from other Rancher installs", "enableTooltip":"Creates an ingress route to the build's repository when it is published, and points the packaged charts at that address instead of the cluster-internal one.", "blocked":({"local":"This Rancher is reached at {address}, which is an address only this machine can use, so there is no hostname another Rancher could fetch the repository from. Builds started here can only be installed on this Rancher.", "port":"This Rancher is reached at {address}. An ingress controller serves ports 80 and 443 and nothing else, so a request to that port would never reach the repository, and an ingress rule cannot carry a port in its hostname either. Builds started here can only be installed on this Rancher.", "none":"This Rancher has no address to offer: server-url is not set, and the address you are using is not one another Rancher could reach. Set server-url and come back, or install this build on this Rancher only."}), "host":"Hostname", "hostTooltip":"A hostname that already routes to this cluster's ingress controller. Pre-filled from the server-url setting, or from the address you are using right now if that setting is not set. Change it if requests to this Rancher do not actually go through an ingress - a Rancher started with docker run is the usual case.", "tls":"Serve over HTTPS", "tlsSecret":"TLS secret", "tlsSecretTooltip":"Only needed if nothing already serves a certificate for this hostname. The secret has to live in the cattle-extensions-builder namespace, so Rancher's own certificate cannot be reused here. Leave empty when Rancher already answers on this hostname over HTTPS.", "tls